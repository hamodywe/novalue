{
  "name": "novalue",
  "version": "0.2.0",
  "description": "Finds the Helm values that render as nothing — the .Values a template reads and no values.yaml defines, and the keys nothing reads back.",
  "keywords": [
    "helm",
    "kubernetes",
    "charts",
    "values",
    "helm-chart",
    "static-analysis",
    "devops",
    "k8s",
    "cli",
    "developer-tools"
  ],
  "homepage": "https://github.com/hamodywe/novalue#readme",
  "bugs": {
    "url": "https://github.com/hamodywe/novalue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamodywe/novalue.git"
  },
  "license": "MIT",
  "author": "hamodywe",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "novalue": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.ts\"",
    "selfcheck": "node src/cli.ts examples/blank"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
